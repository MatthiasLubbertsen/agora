# Public URL users and MCP clients reach this app at. No trailing slash.
# Must match the redirect URIs you register with your login provider.
BASE_URL=https://mcp.example.com
# Used by docker-compose.yml (Caddy) only.
DOMAIN=mcp.example.com

# Login providers for the website. List their ids, then configure each one.
# Redirect URI to register at each provider:  ${BASE_URL}/auth/callback/<id>
OIDC_PROVIDERS=hackclub,tinyauth

OIDC_HACKCLUB_LABEL=Hack Club
OIDC_HACKCLUB_ISSUER=https://your-hack-club-auth-issuer
OIDC_HACKCLUB_CLIENT_ID=
OIDC_HACKCLUB_CLIENT_SECRET=

OIDC_TINYAUTH_LABEL=Tinyauth
OIDC_TINYAUTH_ISSUER=https://tinyauth.example.com
OIDC_TINYAUTH_CLIENT_ID=
OIDC_TINYAUTH_CLIENT_SECRET=

# Optional.
# SECRET_KEY=            # encrypts stored upstream credentials; generated into the data dir if unset
# ALLOW_PRIVATE_UPSTREAMS=false   # allow upstream MCPs on private/loopback addresses
# ADDR=:8080
# DATA_DIR=/data
